# =============================================================================
# TaskFlow Monorepo — Environment Variables Example
# =============================================================================
# Copy this file or configure specific service .env files:
# - Frontend: apps/web/.env.example -> apps/web/.env.local
# - Backend:  services/backend/.env.example -> services/backend/.env
# =============================================================================

# ── Backend Configuration ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=supabase
SERVER_PORT=8080

# Database (PostgreSQL / Supabase Pooler URI)
DB_URL=jdbc:postgresql://aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Security & JWT (Must be at least 256 bits for HS256)
JWT_SECRET=taskflow-dev-secret-key-must-be-at-least-256-bits-long-for-hs256-security
CORS_ORIGINS=http://localhost:3000

# Mail (SMTP - Gmail 16-character App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-16-char-app-password

# Google OAuth & Calendar Integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
TASKFLOW_CALENDAR_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
TASKFLOW_CALENDAR_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Frontend Configuration ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
