# =============================================================================
# TaskFlow Monorepo — Environment Variables Example
# =============================================================================
# Copy this file or configure specific service .env files:
# - Frontend: apps/web/.env.example -> apps/web/.env.local
# - Backend:  services/backend/.env.example -> services/backend/.env
# =============================================================================

# ── Backend Configuration ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (PostgreSQL / Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow_dev_password

# Authentication & JWT
JWT_SECRET=your-256-bit-secret-key-change-this-in-production

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Frontend Configuration ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
