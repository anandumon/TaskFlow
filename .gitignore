# =============================================================================
# TaskFlow .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
build/
dist/
target/
*.jar
*.war
*.class
*.zip

# Environment and secrets (strictly never commit secrets or credentials)
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & coverage
coverage/
.nyc_output/

# Java / Gradle
.gradle/
!**/gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
bin/

# TypeScript
*.tsbuildinfo

# Scratch & ad-hoc scripts
apply-*.cjs
scratch/

# Keys & Certificates
*.pem
*.key
*.cert
*.pfx
*.p12

# Cloud / Hosting
.vercel
.turbo
